# Hashed build output never changes: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Licensed art and ML models keep their names across deploys: cache for a week.
/art/*
  Cache-Control: public, max-age=604800
/ml/*
  Cache-Control: public, max-age=604800

# The page itself must always revalidate so new deploys show up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Service worker and manifest must update promptly.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Sample pics and app icons keep their names across deploys.
/samples/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
